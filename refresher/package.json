{
  "name": "smartthings-pat-refresher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Creates SmartThings personal access tokens automatically from a saved Samsung session, signing in again through Google when it runs out",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "node --env-file-if-exists=.env google.mjs login",
    "login:password": "node --env-file-if-exists=.env login.mjs",
    "start": "node --env-file-if-exists=.env refresh.mjs",
    "renew": "node --env-file-if-exists=.env google.mjs renew",
    "assist": "node --env-file-if-exists=.env assist.mjs",
    "auto": "node --env-file-if-exists=.env auto.mjs"
  },
  "dependencies": {
    "playwright": "^1"
  }
}
