# Required
AC_API_KEY=                # long random string: password for the app, Siri and the refresher

# Optional
ST_DEVICE_ID=              # empty = first device with airConditionerMode
AC_TIMEZONE=America/Sao_Paulo
AC_MOCK=                   # 1 = simulated AC for local development

# Added by the Vercel integrations (Upstash Redis, Upstash QStash)
KV_REST_API_URL=
KV_REST_API_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Only for the paid SmartThings OAuth flow (/api/auth/*)
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_REDIRECT_URI=
CRON_SECRET=
